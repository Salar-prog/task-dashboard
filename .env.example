PORT=8080
# sqlite:/data/app.db (default volume path) or postgres://user:pass@host:5432/dbname?sslmode=disable
DB_URL=sqlite:/data/app.db
TEMPLATES_DIR=/templates
TOKEN_KEY=CHANGE-ME-32-BYTE-HEX
MEMBER_TOKEN=dev-only-fallback
# First-boot accounts only: "email:role,..." — existing users are never reset.
# Roles: member (edit) | senior (read-only). CHANGE the seed password after first login.
SEED_USERS=member1@example.com:member,senior1@example.com:senior
SEED_PASSWORD=CHANGE-ME-AT-FIRST-BOOT
# IMAP intake (per-member app passwords saved via /connect)
IMAP_HOST=outlook.office365.com:993
WATCH_FOLDER_NAME=Task Intake
POLL_EVERY=7m
